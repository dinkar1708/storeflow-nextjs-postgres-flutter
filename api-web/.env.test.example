# Test Environment Configuration Template
# Copy this file to .env.test and adjust values as needed

# Test Database (PostgreSQL on port 5433)
# Run: ./scripts/setup-test-db.sh to set up test database
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/storeflow_test"

# NextAuth Configuration for Tests
NEXTAUTH_URL="http://localhost:3002"
NEXTAUTH_SECRET="test-secret-key-not-for-production"

# App Environment
NODE_ENV="test"
PORT=3002

# Disable rate limiting for tests
DISABLE_RATE_LIMIT="true"

# Swagger docs (optional for tests)
# SWAGGER_DOCS_USERNAME="test"
# SWAGGER_DOCS_PASSWORD="test"

# Email Configuration (optional - can be mocked in tests)
# EMAIL_SERVER_HOST="smtp.gmail.com"
# EMAIL_SERVER_PORT=587
# EMAIL_SERVER_USER="test@example.com"
# EMAIL_SERVER_PASSWORD="test-password"
# EMAIL_FROM="noreply@test.com"
