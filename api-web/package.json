{
  "name": "storeflow-nextjs-postgres-flutter",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p ${PORT:-3001}",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npx dotenv-cli -e .env.test -- vitest run",
    "test:api-login": "npx dotenv-cli -e .env.test -- vitest run __tests__/auth/api-login-seed.test.js",
    "test:watch": "npx dotenv-cli -e .env.test -- vitest",
    "test:ui": "npx dotenv-cli -e .env.test -- vitest --ui",
    "test:e2e": "npx dotenv-cli -e .env.test -- playwright test",
    "test:e2e:ui": "npx dotenv-cli -e .env.test -- playwright test --ui",
    "test:e2e:headed": "npx dotenv-cli -e .env.test -- playwright test --headed",
    "test:e2e:debug": "npx dotenv-cli -e .env.test -- playwright test --debug",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:test": "npx dotenv-cli -e .env.test -- tsx prisma/seed.ts",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "description": "Universal inventory and order management platform",
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "autoprefixer": "^10.4.18",
    "axios": "^1.18.1",
    "bcryptjs": "^2.4.3",
    "jose": "^6.2.2",
    "next": "^14.2.35",
    "next-auth": "^4.24.13",
    "next-swagger-doc": "^0.4.1",
    "postcss": "^8.4.35",
    "prisma": "^5.20.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.8.1",
    "swagger-ui-react": "^5.32.2",
    "tailwindcss": "^3.4.1",
    "typescript": "^6.0.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.0",
    "@types/supertest": "^7.2.0",
    "@vitest/ui": "^1.6.1",
    "dotenv-cli": "^7.4.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.12",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "tsx": "^4.21.0",
    "vitest": "^1.6.1"
  }
}
